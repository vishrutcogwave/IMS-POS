POSTGRES_DB=<database-name>
POSTGRES_USER=<migration-owner-user>
POSTGRES_PASSWORD=<strong-local-database-password>
APP_DB_USER=<restricted-runtime-user>
APP_DB_PASSWORD=<different-strong-runtime-password>
DB_URL=jdbc:postgresql://localhost:5432/<database-name>
DB_USERNAME=<restricted-runtime-user>
DB_PASSWORD=<runtime-password>
DB_MIGRATION_USERNAME=<migration-owner-user>
DB_MIGRATION_PASSWORD=<migration-password>
APP_SEED_DEMO=false
DEMO_PASSWORD=<local-only-demo-password-at-least-12-characters>
APP_ONBOARDING_KEY=<server-issued-onboarding-key>
APP_ORIGIN=<public-frontend-origin>
APP_COOKIE_SECURE=<true-in-production-false-only-for-local-http>
APP_DOCS_ENABLED=<false-in-production>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-email>
MAIL_PASSWORD=<smtp-app-password>
MAIL_FROM=<smtp-from-email>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
